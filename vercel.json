{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/profile.json", "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }] },
    { "source": "/profile.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] },
    { "source": "/(robots|llms).txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] },
    { "source": "/resume", "headers": [{ "key": "Content-Type", "value": "application/pdf" }] }
  ],
  "rewrites": [{ "source": "/resume", "destination": "/resume.pdf" }]
}
